<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        チューナーエージェント。

        **Native AOT。** 別のPCへ置くときに「まず何かを入れてください」が
        要らないことが条件なので、ここは外せない (docs/roadmap.md)。
        出来上がるのは 1.3MB ほどの実行ファイル1個。

        依存を1つも足していない。YAML も JSON も自前で読む —
        AOT では反射を使う既製のものが素直に動かないうえ、読むのは
        こちらが形を決めたファイル2つだけだから。
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PublishAot>true</PublishAot>
        <!-- ioctl と kill を直に呼ぶので要る (LibraryImport が生成する側の都合) -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AssemblyName>denpa-agent</AssemblyName>
        <RootNamespace>Denpa.Agent</RootNamespace>
    </PropertyGroup>

</Project>
