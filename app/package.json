{
    "name": "denpa",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "start": "bun ./build/index.js",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "bun run lint && bun run check && bun test src && playwright test",
        "test:unit": "bun test src",
        "test:e2e": "playwright test",
        "lint": "biome check . && prettier --check \"src/**/*.svelte\"",
        "format": "biome check --write . && prettier --write \"src/**/*.svelte\""
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@playwright/test": "^1.56.1",
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/kit": "^2.49.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.1.16",
        "@types/bun": "^1.3.5",
        "daisyui": "^5.5.5",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.43.10",
        "svelte-check": "^4.3.7",
        "tailwindcss": "^4.1.16",
        "typescript": "^5.9.3",
        "vite": "^8.0.0"
    }
}
