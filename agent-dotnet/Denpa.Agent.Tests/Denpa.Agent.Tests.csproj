<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <!-- 本体は Web SDK なので、テストからは中身のクラスだけ借りる -->
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="../Denpa.Agent/Json.cs" />
        <Compile Include="../Denpa.Agent/Config.cs" />
        <Compile Include="../Denpa.Agent/TunerPool.cs" />
        <Compile Include="../Denpa.Agent/Interop.cs" />
        <Compile Include="../Denpa.Agent/DeviceProbe.cs" />
        <Compile Include="../Denpa.Agent/ChannelTable.cs" />
        <Compile Include="../Denpa.Agent/Tuning.cs" />
        <Compile Include="../Denpa.Agent/AribB25.cs" />
        <Compile Include="../Denpa.Agent/CardShare.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit.v3" Version="3.1.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

</Project>
